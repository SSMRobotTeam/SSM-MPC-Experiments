function Error_Analysis(model,DS,masterModes,Null,auData_3,W_0_3,outdof_endeff)
%ERROR_ANALYSIS 此处显示有关此函数的摘要
%   此处显示详细说明

%% 初值用Comsol生成
% model.component('comp1').physics('solid').feature('pl1').set('Fp', [0.5  0.75  0]);
model.component('comp1').physics('solid').feature('pl1').set('Fp', [0.1  0.1  0]);
model.study('std3').feature('time').set('tlist', 'range(0,0.01,10)');
model.study('std3').feature('time').set('initmethod', 'sol');
model.study('std3').feature('time').set('initstudy', 'std1');
model.study('std3').feature('time').set('solnum', 'last');
model.study('std3').feature('time').set('geometricNonlinearity', true);
model.study("std3").run();
[U0, dUt0] = mphgetu(model, 'soltag', 'sol3');
model.component('comp1').physics('solid').feature('pl1').set('Fp', [0 0 0]);

U     = Null' * U0(3:end);
dU    = Null' * dUt0(3:end);
z    = [U; dU];

% Uhat = DS.spectrum.W(:,masterModes(end:-1:1));
Uhat = DS.spectrum.W(:,masterModes);
p0   = Uhat'*DS.B*z;


%% SSM dynamics
auto_dyn3 = @(t,p) auto_red_dyn(p,auData_3);
time  = [0,4];
[tt3, pt3]    = ode45(auto_dyn3,time,p0);

% Project to physical coordinate
z3  =  [];
for i = 1:length(tt3)
    z3 = [z3, reduced_to_full(pt3(i,:)',W_0_3,[],1)];
end
z3 = z3 * 1000;

%% Linear dynamics
linModes = 1:60;
Vhat = DS.spectrum.V(:,linModes);
Uhat = DS.spectrum.W(:,linModes);
q0   = Uhat'*DS.B*z;
Lamhat   =  diag(DS.spectrum.Lambda(linModes));
auto_linear_red = @(t,q)  Lamhat * q;

[ttr,qtr]    = ode15s(auto_linear_red,time,q0);
z_tr  = [];
for i = 1:length(ttr)
    z_tr = [z_tr, real(Vhat*qtr(i,:)')];
end

z_tr = z_tr*1000;

% Free Vibration Comsol %%%%% 
model.component('comp1').physics('solid').feature('pl1').set('Fp', [0 0 0]);

model.study('std3').feature('time').set('initmethod', 'sol');
model.study('std3').feature('time').set('initstudy', 'std3');
model.study('std3').feature('time').set('solnum', 'last');

model.study('std3').feature('time').set('tlist', 'range(0,0.01,4)');
model.study('std3').feature('time').set('geometricNonlinearity', true);
model.study("std3").run();

% Comsol result
probe1= mphtable(model,"tbl1"); % comsol data
data_comsol = probe1.data(:, 2:end);
time_comsol = probe1.data(:, 1);

save('data_comsol.mat','data_comsol')
save('time_comsol.mat','time_comsol')
% load('data_comsol.mat','data_comsol')
% load('time_comsol.mat','time_comsol')
data_comsol = data_comsol*1000;

%% Plot
LinDispName = ['Linear-O',num2str(linModes(end)),')'];
% Physical coordinate x
plot(tt3, z3(outdof_endeff(1),:),'b-.', DisplayName='O(3)',   LineWidth=2)
plot(time_comsol, data_comsol(:,1),   'k-.', DisplayName='Comsol', LineWidth=2)
plot(ttr, z_tr(outdof_endeff(1),:),'g--',  DisplayName='Linear-O(20)',   LineWidth=2)
xlabel('t')
ylabel('x-endeff')
legend('show')
grid on
set(gca, "FontSize", 18)
xlim([0,time(end)])

% Physical coordinate y
figure; clf; hold on;
plot(tt3, z3(outdof_endeff(2),:),'b-.', DisplayName='O(3)',   LineWidth=2)
plot(time_comsol, data_comsol(:,2),   'k-.', DisplayName='Comsol', LineWidth=2)
plot(ttr, z_tr(outdof_endeff(2),:),'g--',  DisplayName='Linear-O(20)',   LineWidth=2)
xlabel('t')
ylabel('y-endeff')
legend('show')
grid on
set(gca, "FontSize", 18)
xlim([0,time(end)])

% Physical coordinate z 
figure; clf; hold on;
plot(tt3, z3(outdof_endeff(3),:),'b-.', DisplayName='O(3)',   LineWidth=2)
plot(time_comsol, data_comsol(:,3),   'k-.', DisplayName='Comsol', LineWidth=2)
plot(ttr, z_tr(outdof_endeff(3),:),'g--',  DisplayName='Linear-O(20)',   LineWidth=2)
xlabel('t')
ylabel('z-endeff')
legend('show')
grid on
set(gca, "FontSize", 18)
xlim([0,time(end)])

end

